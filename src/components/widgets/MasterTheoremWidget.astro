---
interface Props {
  standalone?: boolean;
}

const { standalone = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class:list={["master-widget", { standalone }]} data-master-widget>
  <div class="widget-heading">
    <div>
      <p class="eyebrow">Laboratorio interattivo</p>
      <h2>Master Theorem</h2>
    </div>
    {!standalone && <a href={`${base}/widgets/master-theorem`}>Apri a pagina intera <span aria-hidden="true">↗</span></a>}
  </div>

  <p class="formula" aria-label="T di n uguale a a per T di n fratto b più n elevato alla k">
    T(n) = <var>a</var>T(n/<var>b</var>) + Θ(n<sup><var>k</var></sup>)
  </p>

  <div class="widget-grid">
    <div class="controls" aria-label="Parametri della ricorrenza">
      <label>
        <span>Sottoproblemi <var>a</var></span>
        <output data-output="a">2</output>
        <input data-input="a" type="range" min="1" max="16" value="2" step="1" />
      </label>
      <label>
        <span>Fattore di riduzione <var>b</var></span>
        <output data-output="b">2</output>
        <input data-input="b" type="range" min="2" max="8" value="2" step="1" />
      </label>
      <label>
        <span>Lavoro esterno <var>k</var></span>
        <output data-output="k">1</output>
        <input data-input="k" type="range" min="0" max="4" value="1" step="0.25" />
      </label>
      <div class="presets" aria-label="Esempi preimpostati">
        <button type="button" data-preset="merge">Merge Sort</button>
        <button type="button" data-preset="binary">Ricerca binaria</button>
        <button type="button" data-preset="strassen">Strassen</button>
      </div>
    </div>

    <div class="result" aria-live="polite">
      <p class="case" data-case>CASO 2 · EQUILIBRIO</p>
      <div class="comparison" aria-hidden="true">
        <div><span>n<sup>log<sub>b</sub>a</sup></span><i data-bar="p"></i></div>
        <strong data-relation>=</strong>
        <div><span>f(n) = n<sup>k</sup></span><i data-bar="k"></i></div>
      </div>
      <p data-explanation>Il lavoro ricorsivo e quello esterno crescono allo stesso ritmo.</p>
      <p class="complexity" data-complexity>T(n) = Θ(n log n)</p>
      <p class="calculation">log<sub data-log-base>2</sub>(<span data-log-value>2</span>) = <strong data-p>1</strong></p>
    </div>
  </div>
</section>

<script>
  const presets = {
    merge: [2, 2, 1],
    binary: [1, 2, 0],
    strassen: [7, 2, 2]
  };

  document.querySelectorAll<HTMLElement>('[data-master-widget]').forEach((widget) => {
    const input = (key: string) => widget.querySelector<HTMLInputElement>(`[data-input="${key}"]`)!;
    const output = (key: string) => widget.querySelector<HTMLOutputElement>(`[data-output="${key}"]`)!;

    const update = () => {
      const a = Number(input('a').value);
      const b = Number(input('b').value);
      const k = Number(input('k').value);
      const p = Math.log(a) / Math.log(b);
      const delta = k - p;
      const tolerance = 0.08;

      output('a').value = String(a);
      output('b').value = String(b);
      output('k').value = String(k);
      widget.querySelector<HTMLElement>('[data-p]')!.textContent = p.toFixed(2).replace(/\.00$/, '');
      widget.querySelector<HTMLElement>('[data-log-base]')!.textContent = String(b);
      widget.querySelector<HTMLElement>('[data-log-value]')!.textContent = String(a);

      const pBar = widget.querySelector<HTMLElement>('[data-bar="p"]')!;
      const kBar = widget.querySelector<HTMLElement>('[data-bar="k"]')!;
      const scale = Math.max(p, k, 1);
      pBar.style.setProperty('--bar', `${Math.max(10, (p / scale) * 100)}%`);
      kBar.style.setProperty('--bar', `${Math.max(10, (k / scale) * 100)}%`);

      let caseLabel;
      let relation;
      let explanation;
      let complexity;
      if (delta < -tolerance) {
        caseLabel = 'CASO 1 · DOMINA LA RICORSIONE';
        relation = '>';
        explanation = 'Il costo prodotto dai sottoproblemi cresce più rapidamente del lavoro esterno.';
        complexity = `T(n) = Θ(n^${p.toFixed(2).replace(/\.00$/, '')})`;
      } else if (delta > tolerance) {
        caseLabel = 'CASO 3 · DOMINA IL LAVORO ESTERNO';
        relation = '<';
        explanation = 'Il lavoro svolto a ogni chiamata cresce più rapidamente del costo ricorsivo.';
        complexity = `T(n) = Θ(n^${k})`;
      } else {
        caseLabel = 'CASO 2 · EQUILIBRIO';
        relation = '=';
        explanation = 'Il lavoro ricorsivo e quello esterno crescono allo stesso ritmo.';
        complexity = `T(n) = Θ(n^${k} log n)`;
      }
      widget.querySelector<HTMLElement>('[data-case]')!.textContent = caseLabel;
      widget.querySelector<HTMLElement>('[data-relation]')!.textContent = relation;
      widget.querySelector<HTMLElement>('[data-explanation]')!.textContent = explanation;
      widget.querySelector<HTMLElement>('[data-complexity]')!.textContent = complexity.replace('n^1 ', 'n ');
    };

    widget.querySelectorAll<HTMLInputElement>('input').forEach((element) => element.addEventListener('input', update));
    widget.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((button) => {
      button.addEventListener('click', () => {
        const values = presets[button.dataset.preset as keyof typeof presets];
        if (!values) return;
        ['a', 'b', 'k'].forEach((key, index) => { input(key).value = String(values[index]); });
        update();
      });
    });
    update();
  });
</script>

<style>
  .master-widget { margin: 2.5rem 0; padding: clamp(1.2rem, 3vw, 2rem); color: #eaf7f3; background: #0d3b35; border: 1px solid #28625a; border-radius: 1.1rem; box-shadow: 0 1.2rem 3rem rgba(13, 59, 53, .16); }
  .master-widget.standalone { margin: 0; }
  .widget-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .widget-heading h2 { margin: .15rem 0 0; color: #fff; font: 700 clamp(1.45rem, 3vw, 2rem)/1.1 var(--font-sans); }
  .widget-heading a { color: #a9e7d9; font-size: .88rem; text-decoration: none; }
  .eyebrow { margin: 0; color: #7ed7c3; font: 700 .72rem/1 var(--font-sans); letter-spacing: .12em; text-transform: uppercase; }
  .formula { margin: 1.5rem 0; padding: .9rem 1rem; border: 1px solid #39746b; border-radius: .75rem; background: #0a302b; color: white; text-align: center; font: 600 clamp(1.15rem, 3vw, 1.6rem)/1.3 var(--font-serif); }
  .widget-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .95fr); gap: 1.5rem; }
  .controls { display: grid; gap: 1rem; }
  label { display: grid; grid-template-columns: 1fr auto; gap: .45rem 1rem; color: #d6eee9; font: 500 .92rem/1.3 var(--font-sans); }
  output { color: white; font-weight: 700; font-variant-numeric: tabular-nums; }
  input { grid-column: 1 / -1; width: 100%; accent-color: #efbb55; }
  .presets { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .25rem; }
  button { padding: .5rem .75rem; color: #eaf7f3; border: 1px solid #438178; border-radius: 999px; background: transparent; font: 600 .78rem var(--font-sans); cursor: pointer; }
  button:hover, button:focus-visible { color: #0d3b35; background: #a9e7d9; outline: none; }
  .result { padding: 1.1rem; border-radius: .8rem; background: #f5faf8; color: #153c36; }
  .case { margin: 0 0 1rem; color: #237162; font: 800 .72rem/1.2 var(--font-sans); letter-spacing: .08em; }
  .comparison { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: .65rem; min-height: 7rem; }
  .comparison div { display: grid; align-content: end; gap: .45rem; height: 100%; color: #365d56; font: 600 .8rem var(--font-sans); text-align: center; }
  .comparison i { display: block; width: 100%; height: var(--bar); min-height: .65rem; border-radius: .35rem .35rem .1rem .1rem; background: #52ad9a; transition: height .25s ease; }
  .comparison div:last-child i { background: #efbb55; }
  .comparison strong { align-self: center; font: 700 1.4rem var(--font-sans); }
  .result > p:not(.case, .complexity, .calculation) { min-height: 2.8em; font: .9rem/1.55 var(--font-sans); }
  .complexity { margin: .8rem 0 .35rem; color: #0d3b35; font: 700 1.2rem/1.25 var(--font-serif); }
  .calculation { margin: 0; color: #5f756f; font: .78rem var(--font-sans); }
  @media (max-width: 700px) { .widget-grid { grid-template-columns: 1fr; } .widget-heading { display: block; } .widget-heading a { display: inline-block; margin-top: .6rem; } }
</style>
